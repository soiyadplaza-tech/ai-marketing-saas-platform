# Public application configuration
NEXT_PUBLIC_SITE_URL=https://foysalit-app.netlify.app
APP_BASE_URL=https://foysalit-app.netlify.app

# Database (server-side only)
DATABASE_URL=

# OpenAI (server-side only; never NEXT_PUBLIC_)
OPENAI_API_KEY=
OPENAI_MODEL=

# Authentication / OAuth (server-side only)
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Email delivery (server-side only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Sent messaging (server-side only)
SENT_API_KEY=
SENT_PROFILE_ID=

# Payments: configure only the gateways actually enabled by the admin
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
ROCKET_MERCHANT_NUMBER=

# Optional observability
SENTRY_DSN=

# Never commit real values to Git. Configure secrets in Netlify/AppDeploy/GitHub environments.
